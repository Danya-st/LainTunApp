<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Типа foregroundServiceType="vpn" и разрешения FOREGROUND_SERVICE_VPN в Android НЕТ
      (aapt2 упадёт на неизвестном значении enum). Для VPN-приложений документирован systemExempted;
      specialUse объявлен как запасной вариант (см. promoteToForeground() в V2RayVpnService).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      BIND_VPN_SERVICE — НЕ <uses-permission>: это signature-permission системы, которую приложения
      получить не могут. Она задаётся атрибутом android:permission у <service> (ниже).
    -->

    <application
        android:name=".V2RayApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.V2RayEz">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.V2RayEz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Redirect вход через Яндекс ID (OAuth + PKCE): myvpn://auth?code=…&state=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myvpn" android:host="auth" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.V2RayVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted|specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Personal VPN tunnel to the owner's own server" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
